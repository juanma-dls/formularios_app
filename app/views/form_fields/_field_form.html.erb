<%= form_with model: [@form, @field], multipart: true do |f| %>
  <%= render "shared/errors", model: @field %>
  <%= f.hidden_field :field_type if @field.new_record? %>

  <p class="text-secondary">Tipo de campo: <strong><%= @field.type_name %></strong></p>

  <div class="mb-3">
    <%= f.label :label, (@field.section? ? "Título de la sección" : "Pregunta"), class: "form-label" %>
    <%= f.text_field :label, class: "form-control", required: true, autofocus: true %>
  </div>

  <div class="mb-3">
    <%= f.label :help_text, (@field.section? ? "Descripción" : "Texto de ayuda"), class: "form-label" %>
    <%= f.text_field :help_text, class: "form-control",
          placeholder: (@field.section? ? "Ej: Completá los datos de tu domicilio" : "Ej: Barrio Los Olivos") %>
    <div class="form-text">
      <%= @field.section? ? "Opcional. Aparece debajo del título de la sección." : "Opcional. Aparece debajo de la pregunta." %>
    </div>
  </div>

  <% if @field.section? %>
    <div class="form-check mb-3">
      <%= f.check_box :starts_page, class: "form-check-input" %>
      <%= f.label :starts_page, "Empezar una página nueva con esta sección", class: "form-check-label" %>
      <div class="form-text">Quien responde ve las preguntas hasta acá y toca "Siguiente" para continuar.</div>
    </div>
  <% end %>

  <% if @field.field_type == "phone" %>
    <div class="form-check mb-3">
      <%= f.check_box :split_area_code, class: "form-check-input" %>
      <%= f.label :split_area_code, "Pedir el código de área por separado", class: "form-check-label" %>
      <div class="form-text">Muestra dos campos, código de área y número, y valida que sea un teléfono argentino.</div>
    </div>
  <% end %>

  <% if @field.choice? %>
    <% image = @field.field_type == "image_choice" %>
    <div class="mb-3" data-controller="options-editor">
      <label class="form-label">Opciones</label>

      <div data-options-editor-target="list">
        <%= f.fields_for :options, @field.options, include_id: false do |of| %>
          <%= render "form_fields/option_row", of: of, image: image %>
        <% end %>
      </div>

      <template data-options-editor-target="template">
        <%= f.fields_for :options, FieldOption.new, child_index: "NEW_OPTION", include_id: false do |of| %>
          <%= render "form_fields/option_row", of: of, image: image %>
        <% end %>
      </template>

      <button type="button" class="btn btn-sm btn-outline-primary" data-action="options-editor#add">
        Agregar opción
      </button>
      <div class="form-text">
        <% if image %>
          Hacé clic en el recuadro de cada opción para elegir su foto (PNG, JPG o WEBP, hasta 5 MB).
          Con Enter agregás otra opción debajo.
        <% else %>
          Con Enter agregás otra opción debajo. Si pegás una lista con una opción por renglón, se cargan todas juntas.
        <% end %>
      </div>
    </div>
  <% end %>

  <% unless @field.section? %>
    <div class="form-check mb-2">
      <%= f.check_box :required, class: "form-check-input" %>
      <%= f.label :required, class: "form-check-label" %>
    </div>
  <% end %>

  <% if FormField::UNIQUE_ALLOWED.include?(@field.field_type) %>
    <div class="form-check mb-3">
      <%= f.check_box :unique_answer, class: "form-check-input" %>
      <%= f.label :unique_answer, class: "form-check-label" %>
      <div class="form-text">Por ejemplo, para permitir un solo voto por DNI. Solo un campo por formulario puede tenerlo.</div>
    </div>
  <% end %>

  <div class="mt-3">
    <%= f.submit "Guardar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", @form, class: "btn btn-link" %>
  </div>
<% end %>