<%= form_with model: [@form, @field] do |f| %>
  <%= render "shared/errors", model: @field %>
  <%= f.hidden_field :field_type if @field.new_record? %>

  <p class="text-secondary">Tipo de campo: <strong><%= @field.type_name %></strong></p>

  <div class="mb-3">
    <%= f.label :label, class: "form-label" %>
    <%= f.text_field :label, class: "form-control", required: true, autofocus: true %>
  </div>

  <div class="mb-3">
    <%= f.label :help_text, class: "form-label" %>
    <%= f.text_field :help_text, class: "form-control", placeholder: "Ej: Barrio Los Olivos" %>
    <div class="form-text">Opcional. Aparece debajo de la pregunta.</div>
  </div>

  <% if @field.choice? %>
    <div class="mb-3">
      <%= f.label :options_text, class: "form-label" %>
      <%= f.text_area :options_text, rows: 8, class: "form-control" %>
      <div class="form-text">
        Una opción por línea.
        <% if @field.field_type == "image_choice" %>La imagen de cada opción se carga en un paso siguiente.<% end %>
      </div>
    </div>
  <% end %>

  <div class="form-check mb-2">
    <%= f.check_box :required, class: "form-check-input" %>
    <%= f.label :required, class: "form-check-label" %>
  </div>

  <% if FormField::UNIQUE_ALLOWED.include?(@field.field_type) %>
    <div class="form-check mb-3">
      <%= f.check_box :unique_answer, class: "form-check-input" %>
      <%= f.label :unique_answer, class: "form-check-label" %>
      <div class="form-text">Por ejemplo, para permitir un solo voto por DNI. Solo un campo por formulario puede tenerlo.</div>
    </div>
  <% end %>

  <div class="mt-3">
    <%= f.submit "Guardar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", @form, class: "btn btn-link" %>
  </div>
<% end %>