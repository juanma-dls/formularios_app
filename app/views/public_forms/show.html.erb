<% content_for :title, @form.title %>

<div class="mx-auto" style="max-width: 720px">
  <% if @preview %>
    <div class="alert alert-info">
      Vista previa: así lo va a ver la gente. Desde acá no se pueden enviar respuestas.
    </div>
  <% end %>

  <div class="bg-white rounded border p-4 mb-3">
    <h1 class="h2 mb-2"><%= @form.title %></h1>
    <% if @form.description.present? %>
      <div class="text-secondary"><%= simple_format(@form.description, {}, wrapper_tag: "p", class: "mb-0") %></div>
    <% end %>
    <div class="small text-danger mt-3">* Obligatorio</div>
  </div>

  <% if @submission&.field_errors&.any? %>
    <div class="alert alert-danger">Revisá las preguntas marcadas en rojo.</div>
  <% end %>

  <%= form_with url: public_form_path(@form.public_id), method: :post do %>
    <% @form.fields.each do |field| %>
      <%= render "public_forms/field", field: field, value: @values[field.key],
                 error: @submission&.field_errors&.dig(field.key) %>
    <% end %>

    <input type="text" name="website" class="d-none" tabindex="-1" autocomplete="off" aria-hidden="true">

    <% unless @preview %>
      <button type="submit" class="btn btn-primary btn-lg w-100" data-turbo-submits-with="Enviando…">Enviar</button>
    <% end %>
  <% end %>
</div>