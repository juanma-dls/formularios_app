<% id = "f_#{field.key}" %>
<% name = "answers[#{field.key}]" %>
<% invalid = error.present? ? " is-invalid" : "" %>
<% group = %w[single_choice multiple_choice image_choice].include?(field.field_type) %>

<div class="bg-white rounded border p-4 mb-3<%= ' border-danger' if error %>" data-split="<%= field.split_area_code? %>"
     data-live-validation-target="field" data-type="<%= field.field_type %>" data-required="<%= field.required? %>"
     <%= "data-has-error" if error %>>
  <%= content_tag(group ? :div : :label, id: "#{id}_label", for: (group ? nil : id),
                  class: "form-label fw-semibold d-block mb-1") do %>
    <%= field.label %><% if field.required? %> <span class="text-danger">*</span><% end %>
  <% end %>

  <% if field.help_text.present? %>
    <div class="form-text mt-0 mb-2"><%= field.help_text %></div>
  <% end %>

  <% case field.field_type %>
  <% when "long_text" %>
    <%= text_area_tag name, value, id: id, rows: 4, maxlength: 5000, class: "form-control#{invalid}" %>

  <% when "number" %>
    <%= text_field_tag name, value, id: id, inputmode: "decimal", class: "form-control#{invalid}" %>

  <% when "email" %>
    <%= email_field_tag name, value, id: id, autocomplete: "email", class: "form-control#{invalid}" %>

  <% when "phone" %>
    <% if field.split_area_code? %>
      <% parts = value.is_a?(Hash) ? value : {} %>
      <div class="row g-2" style="max-width: 26rem">
        <div class="col-4">
          <label class="form-label small text-secondary mb-1" for="<%= id %>">Código de área</label>
          <%= text_field_tag "#{name}[area]", parts["area"], id: id, inputmode: "numeric", maxlength: 5,
                placeholder: "261", autocomplete: "tel-area-code", class: "form-control#{invalid}" %>
        </div>
        <div class="col-8">
          <label class="form-label small text-secondary mb-1" for="<%= id %>_number">Número</label>
          <%= text_field_tag "#{name}[number]", parts["number"], id: "#{id}_number", inputmode: "numeric", maxlength: 10,
                placeholder: "5551234", autocomplete: "tel-local", class: "form-control#{invalid}" %>
        </div>
      </div>
      <div class="form-text">Sin el 0 ni el 15.</div>
    <% else %>
      <%= telephone_field_tag name, value, id: id, autocomplete: "tel", placeholder: "Ej: 2615551234",
            class: "form-control#{invalid}" %>
    <% end %>

  <% when "dni" %>
    <%= text_field_tag name, value, id: id, inputmode: "numeric", maxlength: 10, placeholder: "Solo números",
          class: "form-control#{invalid}" %>

  <% when "date" %>
    <%= date_field_tag name, value, id: id, class: "form-control#{invalid}", style: "max-width: 14rem" %>

  <% when "dropdown" %>
    <%= select_tag name, options_for_select(field.options.map(&:label), value),
          include_blank: "Elegí una opción", id: id, class: "form-select#{invalid}" %>

  <% when "single_choice", "multiple_choice" %>
    <div role="group" aria-labelledby="<%= id %>_label">
      <% field.options.each_with_index do |option, i| %>
        <div class="form-check">
          <% if field.field_type == "multiple_choice" %>
            <%= check_box_tag "#{name}[]", option.label, Array(value).include?(option.label),
                  id: "#{id}_#{i}", class: "form-check-input" %>
          <% else %>
            <%= radio_button_tag name, option.label, value == option.label,
                  id: "#{id}_#{i}", class: "form-check-input" %>
          <% end %>
          <label class="form-check-label" for="<%= id %>_<%= i %>"><%= option.label %></label>
        </div>
      <% end %>
    </div>

  <% when "image_choice" %>
    <div class="row g-3" role="radiogroup" aria-labelledby="<%= id %>_label">
      <% field.options.each_with_index do |option, i| %>
        <div class="col-6 col-md-4">
          <%= radio_button_tag name, option.label, value == option.label,
                id: "#{id}_#{i}", class: "btn-check", autocomplete: "off" %>
          <label class="btn btn-outline-primary w-100 h-100 p-2" for="<%= id %>_<%= i %>">
            <% if option.image.attached? %>
              <%= image_tag option.image.variant(:card), alt: option.label, loading: "lazy",
                    class: "d-block w-100 rounded mb-2", style: "aspect-ratio: 3 / 4; object-fit: cover" %>
            <% else %>
              <div class="bg-light rounded mb-2 d-flex align-items-center justify-content-center text-secondary small"
                  style="aspect-ratio: 3 / 4">Sin imagen</div>
            <% end %>
            <span class="fw-semibold"><%= option.label %></span>
          </label>
        </div>
      <% end %>
    </div>

  <% else %>
    <%= text_field_tag name, value, id: id, maxlength: 255, class: "form-control#{invalid}" %>
  <% end %>

  <div class="text-danger small mt-2" data-role="error" aria-live="polite" <%= "hidden" unless error %>><%= error %></div>
</div>