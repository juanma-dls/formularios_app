<%= render "breadcrumb" %>

<div class="page-header">
  <div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <h1><%= @form.title %></h1>
      <%= form_status_badge(@form) %>
    </div>
    <% if @form.description.present? %>
      <p class="page-subtitle"><%= @form.description %></p>
    <% end %>
  </div>

  <div class="d-flex gap-2 flex-wrap">
    <%= link_to preview_form_path(@form), class: "btn btn-outline-secondary", target: "_blank" do %>
      <i class="bi bi-eye me-1"></i>Vista previa
    <% end %>

    <% unless @form.closed? %>
      <%= link_to edit_form_path(@form), class: "btn btn-outline-secondary" do %>
        <i class="bi bi-gear me-1"></i>Configuración
      <% end %>
    <% end %>

    <% case @form.status %>
    <% when "draft" %>
      <%= button_to publish_form_path(@form), method: :patch, class: "btn btn-success" do %>
        <i class="bi bi-send me-1"></i>Publicar
      <% end %>
    <% when "published" %>
      <%= button_to pause_form_path(@form), method: :patch, class: "btn btn-outline-warning" do %>
        <i class="bi bi-pause-circle me-1"></i>Pausar
      <% end %>
      <%= link_to confirm_close_form_path(@form), class: "btn btn-outline-danger" do %>
        <i class="bi bi-lock me-1"></i>Cerrar
      <% end %>
    <% when "paused" %>
      <%= button_to publish_form_path(@form), method: :patch, class: "btn btn-success" do %>
        <i class="bi bi-play-circle me-1"></i>Reanudar
      <% end %>
      <%= link_to confirm_close_form_path(@form), class: "btn btn-outline-danger" do %>
        <i class="bi bi-lock me-1"></i>Cerrar
      <% end %>
    <% end %>
  </div>
</div>

<% if @form.paused? %>
  <div class="alert alert-warning d-flex gap-2">
    <i class="bi bi-pause-circle-fill"></i>
    <div>El formulario está pausado: el enlace muestra que no recibe respuestas por el momento.</div>
  </div>
<% end %>

<% if @form.closed? %>
  <div class="alert alert-secondary d-flex gap-2">
    <i class="bi bi-lock-fill"></i>
    <div>
      Cerrado el <%= l(@form.closed_at, format: :long) if @form.closed_at %>.
      Ya no recibe respuestas y no se puede modificar.
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h6"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Archivo de respuestas</h2>

      <% if @form.data_purged_at %>
        <p class="mb-0">
          <i class="bi bi-patch-check-fill text-success me-1"></i>
          <% if (first = @form.first_archive_download_at) %>
            Las respuestas se descargaron el <%= l(first, format: :long) %> y
          <% else %>
            Las respuestas
          <% end %>
          se borraron de nuestros servidores el <%= l(@form.data_purged_at, format: :long) %>.
        </p>
      <% elsif @form.archive_error.present? %>
        <p class="text-danger mb-0"><i class="bi bi-exclamation-circle me-1"></i><%= @form.archive_error %></p>
      <% elsif @form.archive.attached? %>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div class="small">
            <% downloads = @form.archive_downloads.count %>
            <div>
              <%= pluralize(@form.results&.dig("total") || 0, "respuesta", plural: "respuestas") %>.
              <%= downloads.zero? ? "Todavía no se descargó." : "Descargado #{downloads == 1 ? '1 vez' : "#{downloads} veces"}." %>
            </div>
            <div class="text-secondary">
              Se borra de nuestros servidores el <%= l(@form.purge_scheduled_at, format: :long) %>.
              <% if downloads.zero? %>Descargalo antes de esa fecha.<% end %>
            </div>
          </div>
          <%= link_to archive_form_path(@form), class: "btn btn-primary", data: { turbo: false } do %>
            <i class="bi bi-download me-1"></i>Descargar Excel
          <% end %>
        </div>
      <% else %>
        <p class="text-secondary mb-0">
          <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
          Estamos preparando el archivo. Recargá en unos segundos.
        </p>
      <% end %>
    </div>
  </div>

  <% if @form.results.present? && @form.results["fields"].any? %>
    <div class="card mb-4">
      <div class="card-body">
        <h2 class="h6 mb-3"><i class="bi bi-bar-chart me-1"></i>Resumen de resultados</h2>
        <% @form.results["fields"].each do |result| %>
          <% field_total = [result["options"].sum { |o| o["count"] }, 1].max %>
          <div class="mb-3">
            <div class="fw-semibold small mb-2"><%= result["label"] %></div>
            <% result["options"].sort_by { |o| -o["count"] }.each do |option| %>
              <% percent = (option["count"] * 100.0 / field_total).round %>
              <div class="d-flex align-items-center gap-2 small mb-1">
                <span class="text-truncate" style="width: 35%"><%= option["label"] %></span>
                <div class="progress flex-grow-1" style="height: 8px" role="presentation">
                  <div class="progress-bar" style="width: <%= percent %>%"></div>
                </div>
                <span class="text-nowrap text-end" style="width: 6rem"><%= option["count"] %> (<%= percent %>%)</span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<div class="card mb-4">
  <div class="list-group list-group-flush">
    <div class="list-group-item py-3">
      <div class="row align-items-center g-2">
        <div class="col-md-3 fw-semibold"><i class="bi bi-link-45deg me-1 text-secondary"></i>Enlace público</div>
        <div class="col-md-9">
          <% if @form.published? %>
            <div class="d-flex flex-wrap gap-3 align-items-start">
              <div class="flex-grow-1" data-controller="clipboard">
                <div class="input-group">
                  <input class="form-control font-monospace" value="<%= public_form_url(@form.public_id) %>" readonly
                        data-clipboard-target="source" data-controller="select-all" data-action="click->select-all#select">
                  <button type="button" class="btn btn-outline-primary" data-clipboard-target="button" data-action="clipboard#copy">
                    <i class="bi bi-clipboard me-1"></i>Copiar
                  </button>
                </div>
                <%= link_to qr_form_path(@form, download: 1), class: "btn btn-sm btn-link px-0 mt-2", data: { turbo: false } do %>
                  <i class="bi bi-qr-code me-1"></i>Descargar código QR
                <% end %>
              </div>
              <img src="<%= qr_form_path(@form) %>" alt="Código QR del formulario" width="112" height="112"
                  class="border rounded bg-white p-1">
            </div>
          <% elsif @form.closed? %>
            <span class="text-secondary">El formulario está cerrado y no recibe respuestas.</span>
          <% else %>
            <span class="text-secondary">Publicalo para obtener el enlace que vas a compartir.</span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="list-group-item py-3">
      <div class="row align-items-center g-2">
        <div class="col-md-3 fw-semibold"><i class="bi bi-table me-1 text-secondary"></i>Planilla</div>
        <div class="col-md-6">
          <% if (source = @form.spreadsheet_source) %>
            <%= link_to source.spreadsheet_title, source.spreadsheet_url, target: "_blank", rel: "noopener" %>
            <div class="small text-secondary"><%= spreadsheet_source_text(@form) %></div>
          <% else %>
            <span class="text-danger">Sin planilla conectada. No se puede publicar hasta conectar una.</span>
          <% end %>
          <%= link_to "¿Cómo funciona?", help_spreadsheets_path(anchor: "donde"), class: "small", target: "_blank" %>
        </div>
        <div class="col-md-3 text-md-end">
          <% if @form.spreadsheet_connected? %>
            <%= button_to "Desconectar", form_spreadsheet_connection_path(@form), method: :delete,
                  class: "btn btn-sm btn-outline-secondary",
                  form: { data: { turbo_confirm: "¿Desconectar? El formulario va a volver a usar la planilla del área." } } %>
          <% else %>
            <%= link_to "Usar planilla propia", new_form_spreadsheet_connection_path(@form), class: "btn btn-sm btn-outline-primary" %>
          <% end %>
        </div>
      </div>
    </div>

    <% if @form.sheet_gid %>
      <% pending = @form.submissions.where(synced_at: nil).count %>
      <div class="list-group-item py-3">
        <div class="row align-items-center g-2">
          <div class="col-md-3 fw-semibold"><i class="bi bi-arrow-repeat me-1 text-secondary"></i>Sincronización</div>
          <div class="col-md-6 small">
            <div>
              <%= pluralize(@form.submissions.count, "respuesta", plural: "respuestas") %>,
              <%= pending.zero? ? "todas en la planilla" : "#{pending} pendientes de enviar" %>
            </div>
            <div class="text-secondary">
              Última sincronización: <%= @form.last_synced_at ? l(@form.last_synced_at, format: :short) : "todavía no" %>
            </div>
            <% if @form.last_sync_error.present? %>
              <div class="text-danger mt-1"><i class="bi bi-exclamation-circle me-1"></i><%= @form.last_sync_error %></div>
            <% end %>
          </div>
          <div class="col-md-3 text-md-end">
            <%= button_to "Sincronizar ahora", sync_form_path(@form), method: :post, class: "btn btn-sm btn-outline-primary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="row g-4">
  <div class="<%= @form.closed? ? 'col-12' : 'col-lg-8' %>">
    <div class="d-flex align-items-baseline justify-content-between mb-3">
      <h2 class="h5 mb-0">Preguntas</h2>
      <% page_count = @form.pages.size %>
      <span class="small text-secondary">
        <%= pluralize(@form.question_count, "pregunta", plural: "preguntas") %><%= " en #{@form.page_count} páginas" if @form.page_count > 1 %>
      </span>
    </div>

    <% if @fields.empty? %>
      <div id="fields_empty" class="card card-body text-secondary mb-2">
        Todavía no hay preguntas. Elegí un tipo en el panel para agregar la primera, o sumá un bloque completo.
      </div>
    <% end %>

    <div data-controller="pages">
      <div class="page-divider d-flex align-items-center gap-2" data-page="1" data-pages-target="firstHeader" hidden>
        <button type="button" class="btn btn-sm btn-link text-body p-0 page-toggle" data-action="pages#toggle"
                aria-expanded="true" aria-label="Mostrar u ocultar las preguntas de esta página">
          <i class="bi bi-chevron-down"></i>
        </button>
        <span class="fw-semibold">Página 1</span>
        <span class="small text-secondary ms-auto" data-page-count></span>
      </div>

      <div id="fields" <%= 'data-controller="sortable"'.html_safe unless @form.closed? %>
          data-sortable-url-value="<%= reorder_form_form_fields_path(@form) %>">
        <%= render partial: "form_fields/form_field", collection: @fields, as: :field, locals: { readonly: @form.closed? } %>
      </div>
    </div>
  </div>

  <% unless @form.closed? %>
    <div class="col-lg-4">
      <div class="position-sticky" style="top: 1rem">
        <div class="card mb-3">
          <div class="card-header bg-white fw-semibold">Agregar pregunta</div>
          <div class="card-body">
            <div class="row row-cols-2 g-2">
              <% FormField::TYPES.each do |type, name| %>
                <%= button_to form_form_fields_path(@form), params: { "form_field[field_type]" => type },
                      form_class: "col", class: "btn btn-sm btn-outline-secondary w-100 h-100 type-button" do %>
                  <i class="bi <%= FormField::ICONS[type] %>"></i><span><%= name %></span>
                <% end %>
              <% end %>
            </div>

            <%= button_to form_form_fields_path(@form),
                  params: { "form_field[field_type]" => "section", "form_field[starts_page]" => "1" },
                  form_class: "mt-2", class: "btn btn-sm btn-outline-primary w-100 type-button justify-content-center" do %>
              <i class="bi bi-file-earmark-plus"></i><span>Nueva página</span>
            <% end %>
          </div>
        </div>

        <div class="card">
          <div class="card-header bg-white fw-semibold">Agregar bloque</div>
          <div class="list-group list-group-flush">
            <% FieldPresets::PRESETS.each do |key, preset| %>
              <%= button_to apply_preset_form_form_fields_path(@form), params: { preset: key },
                    class: "list-group-item list-group-item-action text-start border-0" do %>
                <div class="fw-semibold"><%= preset[:name] %></div>
                <div class="small text-secondary"><%= preset[:description] %></div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="danger-zone d-flex flex-wrap justify-content-between align-items-center gap-3">
  <div>
    <div class="fw-semibold">Eliminar formulario</div>
    <div class="small text-secondary">Se borran sus preguntas y sus respuestas en la app. La planilla de Google no se modifica.</div>
  </div>
  <%= button_to @form, method: :delete, class: "btn btn-outline-danger",
        form: { data: { turbo_confirm: "Se eliminará el formulario con todas sus preguntas y respuestas. ¿Continuar?" } } do %>
    <i class="bi bi-trash me-1"></i>Eliminar formulario
  <% end %>
</div>