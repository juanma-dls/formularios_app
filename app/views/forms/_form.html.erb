<%= form_with model: (@form.new_record? ? [@organization, @area, @form] : @form), multipart: true do |f| %>
  <%= render "shared/errors", model: @form %>

  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", required: true, autofocus: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, rows: 3, class: "form-control" %>
    <div class="form-text">Se muestra debajo del título en el formulario público.</div>
  </div>

  <div class="mb-3">
    <%= f.label :success_message, class: "form-label" %>
    <%= f.text_area :success_message, rows: 2, class: "form-control", placeholder: "¡Gracias! Tu respuesta fue registrada." %>
    <div class="form-text">Lo que ve la persona después de enviar. Si lo dejás vacío se usa el texto de ejemplo.</div>
  </div>

  <div class="mb-3" data-controller="toggle-section">
    <div class="form-check">
      <%= f.check_box :terms_required, class: "form-check-input",
            data: { toggle_section_target: "checkbox", action: "toggle-section#toggle" } %>
      <%= f.label :terms_required, "Pedir que acepten bases y condiciones", class: "form-check-label" %>
    </div>

    <div class="ms-4 mt-2" data-toggle-section-target="section">
      <% if @form.terms_document.attachment&.persisted? %>
        <div class="small mb-2">
          <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
          <%= link_to @form.terms_document.filename.to_s,
                rails_blob_path(@form.terms_document, disposition: "inline"), target: "_blank", rel: "noopener" %>
          <span class="text-secondary">(<%= number_to_human_size(@form.terms_document.byte_size) %>)</span>
        </div>
        <%= f.label :terms_document, "Reemplazar PDF", class: "form-label small" %>
      <% else %>
        <%= f.label :terms_document, "PDF con las bases y condiciones", class: "form-label small" %>
      <% end %>
      <%= f.file_field :terms_document, accept: "application/pdf", class: "form-control" %>
      <div class="form-text">Hasta 10 MB. La persona va a poder abrirlo antes de aceptar.</div>
    </div>
  </div>

  <div class="form-check mb-3">
    <%= f.check_box :captcha_enabled, class: "form-check-input" %>
    <%= f.label :captcha_enabled, "Pedir verificación anti-bots (Cloudflare Turnstile)", class: "form-check-label" %>
    <div class="form-text">
      Recomendado para votaciones y formularios muy difundidos. Casi siempre es invisible;
      solo muestra un desafío si detecta un comportamiento sospechoso.
    </div>
  </div>

  <%= f.submit "Guardar", class: "btn btn-primary" %>
  <%= link_to "Cancelar", (@form.persisted? ? @form : organization_area_forms_path(@organization, @area)), class: "btn btn-link" %>
<% end %>