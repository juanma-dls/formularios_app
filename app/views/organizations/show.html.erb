<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= @organization.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to "Editar", edit_organization_path(@organization), class: "btn btn-outline-secondary" %>
    <%= button_to "Eliminar", @organization, method: :delete, class: "btn btn-outline-danger",
          form: { data: { turbo_confirm: "Se eliminarán la organización y todas sus áreas. ¿Continuar?" } } %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
      <div class="fw-semibold">Planilla de Google</div>
      <% if @organization.spreadsheet_connected? %>
        <%= link_to @organization.spreadsheet_title, @organization.spreadsheet_url, target: "_blank", rel: "noopener" %>
      <% else %>
        <span class="text-secondary">Sin conectar. Las respuestas no se van a poder sincronizar.</span>
      <% end %>
      <div><%= link_to "¿Cómo funciona?", help_spreadsheets_path, class: "small" %></div>
    </div>
    <% if @organization.spreadsheet_connected? %>
      <%= button_to "Desconectar", organization_spreadsheet_connection_path(@organization), method: :delete,
            class: "btn btn-sm btn-outline-danger",
            form: { data: { turbo_confirm: "¿Desconectar la planilla? Los datos que ya tiene no se borran." } } %>
    <% else %>
      <%= link_to "Conectar", new_organization_spreadsheet_connection_path(@organization), class: "btn btn-sm btn-primary" %>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center bg-white">
    <span class="fw-semibold">Áreas</span>
    <%= link_to "Nueva área", new_organization_area_path(@organization), class: "btn btn-sm btn-primary" %>
  </div>

  <% if @areas.any? %>
    <ul class="list-group list-group-flush">
      <% @areas.each do |area| %>
        <li class="list-group-item">
          <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">
            <div class="flex-grow-1 min-w-0">
              <%= link_to area.name, organization_area_forms_path(@organization, area), class: "fw-semibold text-body" %>
              <div class="small text-secondary text-truncate">
                <% if area.spreadsheet_connected? %>
                  <i class="bi bi-table me-1"></i>Planilla propia:
                  <%= link_to area.spreadsheet_title, area.spreadsheet_url, target: "_blank", rel: "noopener" %>
                <% else %>
                  <i class="bi bi-diagram-3 me-1"></i>Usa la planilla de la organización
                <% end %>
              </div>
            </div>

            <div class="d-flex flex-wrap gap-1 flex-shrink-0">
              <%= link_to organization_area_forms_path(@organization, area), class: "btn btn-sm btn-primary" do %>
                <i class="bi bi-ui-checks me-1"></i>Formularios
              <% end %>

              <% if area.spreadsheet_connected? %>
                <%= button_to organization_area_spreadsheet_connection_path(@organization, area), method: :delete,
                      class: "btn btn-sm btn-outline-secondary", title: "Desconectar planilla",
                      aria: { label: "Desconectar planilla" },
                      form: { data: { turbo_confirm: "¿Desconectar la planilla de esta área?" } } do %>
                  <i class="bi bi-x-circle"></i><span class="d-none d-md-inline ms-1">Desconectar planilla</span>
                <% end %>
              <% else %>
                <%= link_to new_organization_area_spreadsheet_connection_path(@organization, area),
                      class: "btn btn-sm btn-outline-primary", title: "Conectar planilla propia",
                      aria: { label: "Conectar planilla propia" } do %>
                  <i class="bi bi-table"></i><span class="d-none d-md-inline ms-1">Planilla propia</span>
                <% end %>
              <% end %>

              <%= link_to edit_organization_area_path(@organization, area),
                    class: "btn btn-sm btn-outline-secondary", title: "Editar área", aria: { label: "Editar área" } do %>
                <i class="bi bi-pencil"></i><span class="d-none d-md-inline ms-1">Editar</span>
              <% end %>

              <%= button_to organization_area_path(@organization, area), method: :delete,
                    class: "btn btn-sm btn-outline-danger", title: "Eliminar área", aria: { label: "Eliminar área" },
                    form: { data: { turbo_confirm: "¿Eliminar el área #{area.name}?" } } do %>
                <i class="bi bi-trash"></i><span class="d-none d-md-inline ms-1">Eliminar</span>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="card-body text-secondary">Esta organización todavía no tiene áreas.</div>
  <% end %>
</div>