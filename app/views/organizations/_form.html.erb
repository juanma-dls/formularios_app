<%= form_with model: organization, multipart: true do |f| %>
  <%= render "shared/errors", model: organization %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", autofocus: true, required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :brand_color, class: "form-label" %>
    <div class="d-flex align-items-center gap-2">
      <%= f.color_field :brand_color, value: organization.brand_color.presence || "#0f5c8c",
            class: "form-control form-control-color" %>
      <span class="form-text m-0">Se usa en los botones y detalles de los formularios públicos.</span>
    </div>
  </div>

  <% { logo: "Logo", banner: "Banner" }.each do |name, title| %>
    <% file = organization.public_send(name) %>
    <div class="mb-3">
      <%= f.label name, title, class: "form-label" %>
      <% if file.attachment&.persisted? %>
        <div class="d-flex align-items-center gap-3 mb-2">
          <%= image_tag file.variant(:header), alt: "", class: "border rounded bg-white",
                style: "max-height: 64px; max-width: 240px; object-fit: contain" %>
          <div class="form-check">
            <%= f.check_box "remove_#{name}", class: "form-check-input" %>
            <%= f.label "remove_#{name}", "Quitar", class: "form-check-label" %>
          </div>
        </div>
      <% end %>
      <%= f.file_field name, accept: "image/png,image/jpeg,image/webp", class: "form-control" %>
      <div class="form-text">
        <%= name == :banner ? "Imagen ancha que encabeza el formulario, ideal 1440 × 480 px." : "Se muestra junto al nombre de la organización." %>
      </div>
    </div>
  <% end %>

  <%= f.submit "Guardar", class: "btn btn-primary" %>
  <%= link_to "Cancelar", organization.persisted? ? organization : organizations_path, class: "btn btn-link" %>
<% end %>